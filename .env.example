# Environment Variables — NEVER commit this file
# Copy this to .env and fill in real values

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB (the database name "portfolio" is set in src/config/db.js)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# Only if you see "querySrv ECONNREFUSED" locally: DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=

# YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-channel-id

# Contact form email (https://resend.com). Fill both in to receive messages by email.
# CONTACT_TO_EMAIL must be the address your Resend account is registered with.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
